# Anthropic key from https://console.anthropic.com (blank = offline rule-engine mode)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
PORT=3000
# Optional live threat intelligence (free keys): virustotal.com, abuseipdb.com
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
# Optional PostgreSQL. Blank = local JSON file store.
DATABASE_URL=
# Optional. Auto-generated into data/.secret if blank.
SESSION_SECRET=
